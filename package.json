{
  "name": "luquinhas-boost",
  "version": "1.3.3",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "productName": "Luquinhas Boost",
    "appId": "com.luquinhas.boost",
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "copyright": "Luquinhas Boost",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Luquinhas Boost",
      "runAfterFinish": true
    }
  },
  "description": "Otimizador e limpeza do Windows para CS2",
  "author": "Luquinhas",
  "homepage": "https://github.com/lucasschwerz/luquinhas-boost"
}